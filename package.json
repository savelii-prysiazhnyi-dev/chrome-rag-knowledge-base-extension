{
  "name": "chrome-rag-knowledge-base-extension",
  "version": "0.1.0",
  "description": "Local-first Chrome extension knowledge assistant with semantic vector search",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --no-error-on-unmatched-pattern --fix"
  },
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
